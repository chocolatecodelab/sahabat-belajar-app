generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================
// AUTHENTICATION & RBAC
// ============================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String   // bcrypt hashed
  avatar    String?
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tutor     Tutor?
  student   Student?
  articles  Article[]   @relation("ArticleAuthor")
  pages     Page[]      @relation("PageAuthor")
  mediaFiles MediaFile[]

  @@index([roleId])
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique // "Admin", "Staf", "Tutor", "Siswa", "Orang Tua"
  description String?
  permissions Permission[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id     String @id @default(cuid())
  name   String @unique // e.g., "lead.manage", "session.create"
  module String // e.g., "lead", "student", "tutor", "schedule"
  action String // e.g., "create", "read", "update", "delete"
  roles  Role[]

  @@index([module])
}

// ============================
// SAHABAT BELAJAR: LEADS & STUDENTS (MODUL A & B)
// ============================

model Lead {
  id              String     @id @default(cuid())
  name            String
  phone           String     // Format internasional E.164 atau lokal
  email           String?
  programInterest String?    // K12, CPNS_BUMN, S2_S3_BEASISWA, TOEFL_IELTS, PENULISAN_ILMIAH
  level           String?    // SD, SMP, SMA, Kuliah, Umum
  classModel      String?    // PRIVAT, SEMI_PRIVAT
  learningMode    String?    // ONLINE, HOME_VISIT
  source          String     @default("WEBSITE") // WEBSITE, WHATSAPP, INSTAGRAM
  status          LeadStatus @default(BARU)
  notes           String?    @db.Text
  assignedTo      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  students        Student[]

  @@index([status])
  @@index([phone])
  @@index([createdAt])
}

enum LeadStatus {
  BARU
  DIHUBUNGI
  IKUT_PLACEMENT
  DAFTAR
  BATAL
}

model Student {
  id              String          @id @default(cuid())
  userId          String?         @unique
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  leadId          String?
  lead            Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  name            String
  level           String          // SD, SMP, SMA, Kuliah, Umum
  school          String?         // Sekolah / Universitas / Instansi
  parentName      String?
  parentPhone     String?         // Nomor kontak orang tua
  parentConsentAt DateTime?       // BR-8: Persetujuan orang tua untuk siswa anak
  status          StudentStatus   @default(AKTIF)
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  packages        StudentPackage[]
  participations  SessionParticipant[]

  @@index([status])
  @@index([name])
}

enum StudentStatus {
  AKTIF
  NONAKTIF
  LULUS
  CUTI
}

// ============================
// SAHABAT BELAJAR: TUTORS (MODUL B & E)
// ============================

model Tutor {
  id             String        @id @default(cuid())
  userId         String?       @unique
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name           String
  phone          String        // WhatsApp
  email          String?
  expertise      String[]      // Keahlian ["Matematika", "Bahasa Inggris", "TKP/TIU"]
  ratePerSession Int           @default(100000) // BR-7: Rahasia honor per sesi
  status         TutorStatus   @default(AKTIF)
  bio            String?       @db.Text
  avatar         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sessions       Session[]
  payouts        TutorPayout[]

  @@index([status])
  @@index([phone])
}

enum TutorStatus {
  AKTIF
  NONAKTIF
  CUTI
}

// ============================
// SAHABAT BELAJAR: PROGRAMS & PACKAGES (MODUL B & D)
// ============================

model Program {
  id          String   @id @default(cuid())
  name        String   // e.g. "Bimbel K-12", "Persiapan CPNS/BUMN", "TOEFL Prep"
  category    String   // K12, CPNS_BUMN, S2_S3_BEASISWA, TOEFL_IELTS, PENULISAN_ILMIAH
  description String?  @db.Text
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  packages    Package[]
  sessions    Session[]

  @@index([category])
  @@index([isActive])
}

model Package {
  id             String      @id @default(cuid())
  programId      String?
  program        Program?    @relation(fields: [programId], references: [id], onDelete: SetNull)
  name           String      // "Paket 10 Pertemuan Privat", "Paket Semester 6 Bulan"
  type           PackageType @default(QUOTA)
  durationMonths Int?        // Jika paket berbasis waktu
  quotaSessions  Int?        // Jika paket berbasis kuota
  sessionMinutes Int         @default(90) // BR-5: Durasi default 90 menit per sesi
  price          Int         @default(0)
  isActive       Boolean     @default(true)
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  studentPackages StudentPackage[]

  @@index([type])
  @@index([isActive])
}

enum PackageType {
  CUSTOM
  TIME
  QUOTA
}

model StudentPackage {
  id             String               @id @default(cuid())
  studentId      String
  student        Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  packageId      String
  package        Package              @relation(fields: [packageId], references: [id], onDelete: Cascade)
  quotaTotal     Int                  @default(0)
  quotaUsed      Int                  @default(0)
  startDate      DateTime             @default(now())
  endDate        DateTime?
  status         StudentPackageStatus @default(AKTIF)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  payments       Payment[]
  participations SessionParticipant[]

  @@index([studentId])
  @@index([packageId])
  @@index([status])
}

enum StudentPackageStatus {
  AKTIF
  HAMPIR_HABIS
  HABIS
  KEDALUWARSA
}

model Payment {
  id               String         @id @default(cuid())
  studentPackageId String
  studentPackage   StudentPackage @relation(fields: [studentPackageId], references: [id], onDelete: Cascade)
  amount           Int
  paidAt           DateTime       @default(now())
  method           String         @default("TRANSFER_BANK") // TRANSFER_BANK, QRIS, CASH
  proofFile        String?        // Bukti transfer
  status           PaymentStatus  @default(LUNAS)
  notes            String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([studentPackageId])
  @@index([status])
  @@index([paidAt])
}

enum PaymentStatus {
  LUNAS
  SEBAGIAN
  BELUM
}

// ============================
// SAHABAT BELAJAR: SESSIONS & SCHEDULING (MODUL C)
// ============================

model Session {
  id           String        @id @default(cuid())
  tutorId      String
  tutor        Tutor         @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  programId    String
  program      Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  classType    String        @default("PRIVAT") // PRIVAT, SEMI_PRIVAT
  mode         String        @default("ONLINE") // ONLINE, HOME_VISIT
  startAt      DateTime
  endAt        DateTime
  meetingLink  String?       // Zoom / Google Meet
  address      String?       @db.Text // Alamat jika Home Visit
  status       SessionStatus @default(TERJADWAL)
  recurrenceId String?       // ID grup jadwal mingguan berulang
  cancelReason String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  participants SessionParticipant[]
  journal      SessionJournal?

  @@index([tutorId])
  @@index([programId])
  @@index([startAt])
  @@index([status])
}

enum SessionStatus {
  TERJADWAL
  TERLAKSANA
  DIJADWAL_ULANG
  DIBATALKAN
}

model SessionParticipant {
  id               String           @id @default(cuid())
  sessionId        String
  session          Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentPackageId String?
  studentPackage   StudentPackage?  @relation(fields: [studentPackageId], references: [id], onDelete: SetNull)
  attendance       AttendanceStatus @default(HADIR)
  quotaDeducted    Boolean          @default(false) // BR-1: Dihitung saat TERLAKSANA
  createdAt        DateTime         @default(now())

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
}

enum AttendanceStatus {
  HADIR
  IZIN
  ALPA
}

model SessionJournal {
  id        String   @id @default(cuid())
  sessionId String   @unique
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  topic     String   // Materi yang dipelajari
  notes     String?  @db.Text // Catatan perkembangan siswa
  homework  String?  @db.Text // Tugas rumah
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================
// SAHABAT BELAJAR: TUTOR PAYOUTS (MODUL E)
// ============================

model TutorPayout {
  id            String       @id @default(cuid())
  tutorId       String
  tutor         Tutor        @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  periodStart   DateTime
  periodEnd     DateTime
  totalSessions Int          @default(0)
  totalAmount   Int          @default(0) // BR-6: Sesi terlaksana * tarif tutor
  status        PayoutStatus @default(DRAFT)
  paidAt        DateTime?
  notes         String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tutorId])
  @@index([status])
  @@index([periodStart, periodEnd])
}

enum PayoutStatus {
  DRAFT
  DISETUJUI
  DIBAYAR
}

// ============================
// TEMPLATE: CMS & ADMIN SHELL
// ============================

model AdminMenu {
  id         String      @id @default(cuid())
  label      String
  icon       String?     // Lucide icon name
  url        String
  parentId   String?
  parent     AdminMenu?  @relation("AdminMenuTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   AdminMenu[] @relation("AdminMenuTree")
  sortOrder  Int         @default(0)
  isActive   Boolean     @default(true)
  permission String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([parentId])
}

model MediaFile {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  url          String
  mimeType     String
  size         Int
  folder       String   @default("general")
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([folder])
  @@index([uploadedById])
}

model SiteSettings {
  id              String   @id @default(cuid())
  siteName        String   @default("Sahabat Belajar")
  siteDescription String?  @db.Text
  logo            String?
  favicon         String?
  contactEmail    String?
  contactPhone    String?
  address         String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  category  String?  // "Pendaftaran", "Program & Paket", "Jadwal & Tutor"
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Page {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  content         String     @db.Text
  excerpt         String?    @db.Text
  featuredImage   String?
  status          String     @default("PUBLISHED")
  authorId        String
  author          User       @relation("PageAuthor", fields: [authorId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([authorId])
  @@index([slug])
}

model Article {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  content         String    @db.Text
  excerpt         String?   @db.Text
  featuredImage   String?
  status          String    @default("PUBLISHED")
  authorId        String
  author          User      @relation("ArticleAuthor", fields: [authorId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([authorId])
  @@index([slug])
}

// ============================
// MODUL & BANK MATERI BELAJAR DIGITAL
// ============================

model LearningMaterial {
  id              String   @id @default(cuid())
  title           String
  programCategory String   // K12, CPNS_BUMN, UTBK_SNBT, TOEFL_IELTS, S2_BEASISWA
  subject         String
  description     String?  @db.Text
  fileUrl         String
  fileName        String
  fileSize        String   @default("2.0 MB")
  authorTutor     String   @default("Tim Akademik Sahabat Belajar")
  downloadCount   Int      @default(0)
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([programCategory])
  @@index([isPublished])
}

