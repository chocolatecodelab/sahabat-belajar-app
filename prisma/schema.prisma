generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================
// AUTHENTICATION & AUTHORIZATION
// ============================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String   // bcrypt hashed
  avatar    String?
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles   Article[]   @relation("ArticleAuthor")
  pages      Page[]      @relation("PageAuthor")
  mediaFiles MediaFile[]

  @@index([roleId])
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique // "Super Admin", "Admin", "Editor", "Viewer"
  description String?
  permissions Permission[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id     String @id @default(cuid())
  name   String @unique // e.g., "page.create", "article.delete"
  module String // e.g., "page", "article", "category"
  action String // e.g., "create", "read", "update", "delete"
  roles  Role[]

  @@index([module])
}

// ============================
// CONTENT MANAGEMENT
// ============================

model Page {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  content         String     @db.Text // HTML content from TinyMCE
  excerpt         String?    @db.Text
  featuredImage   String?
  status          PageStatus @default(DRAFT)
  sortOrder       Int        @default(0)
  authorId        String
  author          User       @relation("PageAuthor", fields: [authorId], references: [id])
  metaTitle       String?
  metaDescription String?    @db.Text
  navigations     Navigation[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([authorId])
  @@index([status])
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Article {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  content         String        @db.Text // HTML content from TinyMCE
  excerpt         String?       @db.Text
  featuredImage   String?       // Cover image / Gambar sampul
  status          ArticleStatus @default(DRAFT)
  publishedAt     DateTime?
  authorId        String
  author          User          @relation("ArticleAuthor", fields: [authorId], references: [id])
  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id])
  tags            Tag[]
  viewCount       Int           @default(0)
  metaTitle       String?
  metaDescription String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([authorId])
  @@index([categoryId])
  @@index([status])
  @@index([publishedAt])
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  color       String?   // Hex color for category badge
  articles    Article[]
  navigations Navigation[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  articles Article[]
}

// ============================
// NAVIGATION
// ============================

model Navigation {
  id           String       @id @default(cuid())
  label        String
  type         NavType      // LINK, PAGE, CATEGORY, EXTERNAL
  url          String?      // for EXTERNAL type
  pageId       String?
  page         Page?        @relation(fields: [pageId], references: [id], onDelete: SetNull)
  categoryId   String?
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  parentId     String?
  parent       Navigation?  @relation("NavigationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Navigation[] @relation("NavigationTree")
  sortOrder    Int          @default(0)
  location     NavLocation  @default(HEADER)
  isActive     Boolean      @default(true)
  openInNewTab Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([parentId])
  @@index([location])
}

enum NavType {
  LINK
  PAGE
  CATEGORY
  EXTERNAL
}

enum NavLocation {
  HEADER
  FOOTER
}

// ============================
// LANDING PAGE APPEARANCE
// ============================

model HeroSlide {
  id              String   @id @default(cuid())
  title           String
  subtitle        String?  @db.Text
  backgroundImage String
  ctaText         String?
  ctaLink         String?
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  icon        String   // Lucide icon name
  link        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SocialMedia {
  id        String   @id @default(cuid())
  platform  String   // "instagram", "facebook", "twitter", "youtube"
  username  String
  url       String
  embedCode String?  @db.Text // For Instagram embed
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id              String   @id @default(cuid())
  siteName        String   @default("BIAS RISTEK")
  siteDescription String?  @db.Text
  logo            String?
  favicon         String?
  contactEmail    String?
  contactPhone    String?
  address         String?  @db.Text
  newsPerPage     Int      @default(6)
  heroEnabled     Boolean  @default(true)
  serviceEnabled  Boolean  @default(true)
  newsEnabled     Boolean  @default(true)
  socialEnabled   Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AdminMenu {
  id         String      @id @default(cuid())
  label      String
  icon       String?     // Lucide icon name
  url        String
  parentId   String?
  parent     AdminMenu?  @relation("AdminMenuTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   AdminMenu[] @relation("AdminMenuTree")
  sortOrder  Int         @default(0)
  isActive   Boolean     @default(true)
  permission String?     // Required permission to see this menu
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([parentId])
}

model StatCounter {
  id        String   @id @default(cuid())
  value     String   // e.g. "2.500+", "180+", "98%"
  label     String   // e.g. "Alumni Peneliti", "Artikel Scopus & SINTA"
  icon      String?  // Lucide icon name
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LearningStep {
  id          String   @id @default(cuid())
  stepNumber  Int      // 1, 2, 3, 4
  title       String
  description String   @db.Text
  icon        String?  // Lucide icon name
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Advantage {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  icon        String   // Lucide icon name
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id          String   @id @default(cuid())
  name        String
  role        String   // e.g. "Mahasiswa S2 / Peneliti", "Dosen Universitas X"
  institution String?  // e.g. "Universitas Lambung Mangkurat"
  content     String   @db.Text
  avatar      String?  // Image URL
  rating      Int      @default(5)
  achievement String?  // e.g. "Tembus Scopus Q2", "Lulus Tesis Nilai A"
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  category  String?  // e.g. "Pendaftaran", "Bimbingan", "Sertifikat"
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================
// MEDIA & ASSET MANAGEMENT
// ============================

model MediaFile {
  id           String   @id @default(cuid())
  filename     String   // Sanitized filename on disk
  originalName String   // Original upload name
  url          String   // Public URL e.g. "/uploads/covers/xxx.webp"
  mimeType     String   // e.g. "image/webp", "image/png", "application/pdf"
  size         Int      // Size in bytes
  folder       String   @default("general") // "covers", "pages", "general", "avatars", "documents"
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([folder])
  @@index([mimeType])
  @@index([uploadedById])
  @@index([createdAt])
}

// ============================
// ACADEMIC COURSE & ENROLLMENT
// ============================

model Course {
  id              String         @id @default(cuid())
  title           String
  slug            String         @unique
  tagline         String?        // e.g. "Panduan Tembus Scopus Q1/Q2 Dari Nol"
  description     String         @db.Text // Full overview HTML
  category        String         // "Scopus & SINTA", "SmartPLS & SEM", "SPSS & Statistik", "Bimbingan Tesis", "Metodologi"
  price           Int            @default(0) // Normal price in IDR
  salePrice       Int?           // Discounted promo price
  isFree          Boolean        @default(false)
  level           String         @default("Semua Jenjang") // "Pemula", "Menengah", "Lanjutan", "Semua Jenjang"
  deliveryMode    String         @default("Live Zoom & Mentorship") // "Live Zoom", "1-on-1 Mentorship", "Video On-Demand"
  batchNumber     String?        // e.g. "Batch 14"
  startDate       String?        // e.g. "15 September 2026"
  duration        String?        // e.g. "4 Minggu (8 Sesi Bimbingan)"
  maxQuota        Int            @default(30)
  currentEnrolled Int            @default(0)
  featuredImage   String?        // Cover image URL
  mentorName      String         @default("Dr. Ir. Tim Pakar Riset")
  mentorTitle     String         @default("Senior Researcher & Reviewer Scopus Q1")
  mentorAvatar    String?
  curriculum      String?        @db.Text // JSON or bullet points of syllabus
  benefits        String?        @db.Text // JSON or bullet points of features (E-Sertifikat, Rekaman, Template Olah Data)
  status          CourseStatus   @default(OPEN)
  sortOrder       Int            @default(0)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  registrations   CourseRegistration[]

  @@index([category])
  @@index([status])
  @@index([isActive])
}

enum CourseStatus {
  OPEN
  UPCOMING
  FULL
  CLOSED
}

model CourseRegistration {
  id             String             @id @default(cuid())
  invoiceNumber  String             @unique // e.g. "INV-202608-001"
  courseId       String
  course         Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseTitle    String
  name           String             // Full name for Certificate
  email          String
  phone          String             // WhatsApp number
  institution    String             // University / Research Institution
  educationLevel String             // "S1 (Skripsi)", "S2 (Tesis)", "S3 (Disertasi)", "Dosen / Peneliti", "Umum"
  researchTopic  String?            @db.Text // Topic / research obstacles
  totalAmount    Int                @default(0)
  uniqueCode     Int                @default(0) // 3-digit verification code (e.g. 347)
  paymentMethod  String             @default("QRIS") // "QRIS", "BANK_TRANSFER", "FREE"
  bankName       String?            // "BCA", "Mandiri", "BSI", etc.
  paymentProof   String?            // Image receipt URL
  status         EnrollmentStatus   @default(PENDING_PAYMENT)
  adminNotes     String?            @db.Text // Internal follow-up notes
  verifiedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([courseId])
  @@index([status])
  @@index([createdAt])
}

enum EnrollmentStatus {
  PENDING_PAYMENT    // Belum Melakukan Pembayaran
  PAYMENT_UPLOADED   // Bukti Transfer Diunggah (Menunggu Verifikasi)
  VERIFIED           // Lunas & Resmi Terdaftar
  REJECTED           // Bukti Tidak Valid / Ditolak
  CANCELLED          // Dibatalkan
}

model PaymentAccount {
  id            String   @id @default(cuid())
  type          String   @default("BANK") // "BANK" or "QRIS"
  bankName      String   // "BCA", "Bank Mandiri", "BSI", "QRIS Official"
  accountNumber String?  // "1234567890" (or null if QRIS)
  accountHolder String?  // "BIAS RISTEK AKADEMIK"
  qrisImage     String?  // Image barcode URL
  instructions  String?  @db.Text // Transfer instructions
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}



